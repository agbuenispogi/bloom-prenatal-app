{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["project-memory"],
  "permissions": {
    "allow": [
      "mcp__project-memory__qdrant-find",
      "mcp__project-memory__qdrant-store",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright test*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(npx supabase db push*)",
      "Bash(npx supabase functions deploy*)",
      "Bash(npx vercel*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production*)"
    ]
  }
}
