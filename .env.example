# Copy to .env.local for local dev. Real values live in Vercel env + Supabase secrets only. Never commit them.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (Project Settings → API Keys)
SUPABASE_SECRET_KEY=                    # sb_secret_… server only (reminders, summaries). Never NEXT_PUBLIC_

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Email (Resend). The sending domain must be verified in Resend to email anyone besides the account owner
RESEND_API_KEY=
EMAIL_FROM=                         # e.g. "Bloom <bloom@yourdomain.com>"

# Shared secret: pg_cron → pg_net → dispatch-reminders edge function
CRON_SECRET=

# Public base URL for links in emails and .ics files
NEXT_PUBLIC_APP_URL=http://localhost:3000
